<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             typeLanguage="http://www.w3.org/2001/XMLSchema"
             expressionLanguage="http://www.w3.org/1999/XPath"
             targetNamespace="http://www.flowable.org/processdef">

  <!--
    流程：问题归零
    ProcessDefinitionKey : problem_zero
    BusinessType         : problem_zero

    流程路径：
      UT-01 问题发起人启动流程（单人）
      UT-02 发现问题班组负责人问题确认
      UT-03 质控人员组确认，提交 IS_SOLVED
        true  -> ST-07 框架回调业务系统 -> 结束
        false -> UT-04 责任人确认
      UT-04 责任人确认，提交 PROBLEM_ATTRIBUTE
      EG-02 判断 PROBLEM_ATTRIBUTE 是否专项工作
        true  -> UT-05 对口领导审核 -> UT-06 发现问题人确认
        false -> UT-06 发现问题人确认
      ST-07 框架回调业务系统

    变量说明：
      starterAssignee              : 问题发起人工号，启动时传入
      teamLeaderAssigneeList       : 发现问题班组负责人工号列表，UT-01 完成时通过 slot 写入
      qualityAssigneeList          : 质控人员组工号列表，UT-02 完成时通过 slot 写入
      IS_SOLVED                    : 是否已解决，UT-03 完成时由业务变量传入 true/false
      responsibleAssigneeList      : 责任人工号列表，IS_SOLVED=false 时由 UT-03 slot 写入
      PROBLEM_ATTRIBUTE            : 是否专项工作，UT-04 完成时由业务变量传入 true/false
      counterpartLeaderAssigneeList: 对口领导工号列表，专项工作路径使用
      discovererAssigneeList       : 发现问题人工号列表
  -->
  <process id="problem_zero"
           name="问题归零"
           isExecutable="true">

    <startEvent id="start_event" name="开始"/>

    <sequenceFlow id="flow_start_to_ut01"
                  sourceRef="start_event"
                  targetRef="ut01_starter_submit"/>

    <userTask id="ut01_starter_submit"
              name="问题发起人启动流程"
              flowable:assignee="${starterAssignee}">
      <documentation>
        处理人: 启动时由业务系统传入 starterAssignee
        操作: 创建问题归零流程，提交问题基本信息
        slots: 选发现问题班组负责人 -> teamLeaderAssigneeList
      </documentation>
      <extensionElements>
        <flowable:field name="nodeSemantic" stringValue="PROBLEM_ZERO_STARTER_SUBMIT"/>
        <flowable:field name="pageCode" stringValue="ProblemZero/StarterSubmitForm"/>
        <flowable:field name="isConvergencePoint" stringValue="false"/>
      </extensionElements>
    </userTask>

    <sequenceFlow id="flow_ut01_to_ut02"
                  sourceRef="ut01_starter_submit"
                  targetRef="ut02_team_leader_confirm"/>

    <userTask id="ut02_team_leader_confirm"
              name="发现问题班组负责人问题确认"
              flowable:assignee="${teamLeaderAssignee.asText()}">
      <documentation>
        处理人: UT-01 完成时通过 teamLeaderAssigneeList 指定，节点并行或签
        操作: 班组负责人确认问题信息
        slots: 选质控人员组 -> qualityAssigneeList
      </documentation>
      <extensionElements>
        <flowable:field name="nodeSemantic" stringValue="PROBLEM_ZERO_TEAM_LEADER_CONFIRM"/>
        <flowable:field name="pageCode" stringValue="ProblemZero/TeamLeaderConfirmForm"/>
        <flowable:field name="isConvergencePoint" stringValue="false"/>
      </extensionElements>
      <multiInstanceLoopCharacteristics isSequential="false"
                                        flowable:collection="${teamLeaderAssigneeList}"
                                        flowable:elementVariable="teamLeaderAssignee">
        <completionCondition>${nrOfCompletedInstances &gt;= 1}</completionCondition>
      </multiInstanceLoopCharacteristics>
    </userTask>

    <sequenceFlow id="flow_ut02_to_ut03"
                  sourceRef="ut02_team_leader_confirm"
                  targetRef="ut03_quality_group_confirm"/>

    <userTask id="ut03_quality_group_confirm"
              name="质控人员组确认"
              flowable:assignee="${qualityAssignee.asText()}">
      <documentation>
        处理人: UT-02 完成时通过 qualityAssigneeList 指定多个质控人员
        操作: 质控人员组确认是否已解决，并提交 IS_SOLVED
        slots(IS_SOLVED=false): 选责任人 -> responsibleAssigneeList
      </documentation>
      <extensionElements>
        <flowable:field name="nodeSemantic" stringValue="PROBLEM_ZERO_QUALITY_GROUP_CONFIRM"/>
        <flowable:field name="pageCode" stringValue="ProblemZero/QualityGroupConfirmForm"/>
        <flowable:field name="isConvergencePoint" stringValue="false"/>
      </extensionElements>
      <multiInstanceLoopCharacteristics isSequential="false"
                                        flowable:collection="${qualityAssigneeList}"
                                        flowable:elementVariable="qualityAssignee">
        <completionCondition>${nrOfCompletedInstances &gt;= 1}</completionCondition>
      </multiInstanceLoopCharacteristics>
    </userTask>

    <sequenceFlow id="flow_ut03_to_eg01"
                  sourceRef="ut03_quality_group_confirm"
                  targetRef="eg01_is_solved"/>

    <exclusiveGateway id="eg01_is_solved" name="是否已解决？"/>

    <sequenceFlow id="flow_eg01_true_to_st07"
                  name="已解决"
                  sourceRef="eg01_is_solved"
                  targetRef="st07_framework_callback">
      <conditionExpression xsi:type="tFormalExpression">${IS_SOLVED == true}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="flow_eg01_false_to_ut04"
                  name="未解决"
                  sourceRef="eg01_is_solved"
                  targetRef="ut04_responsible_confirm">
      <conditionExpression xsi:type="tFormalExpression">${IS_SOLVED == false}</conditionExpression>
    </sequenceFlow>

    <userTask id="ut04_responsible_confirm"
              name="责任人确认"
              flowable:assignee="${responsibleAssignee.asText()}">
      <documentation>
        处理人: UT-03 完成时通过 responsibleAssigneeList 指定，节点并行或签
        操作: 责任人确认整改/归零措施，并提交 PROBLEM_ATTRIBUTE
        slots(PROBLEM_ATTRIBUTE=true):  选对口领导 -> counterpartLeaderAssigneeList
        slots(PROBLEM_ATTRIBUTE=false): 选发现问题人 -> discovererAssigneeList
      </documentation>
      <extensionElements>
        <flowable:field name="nodeSemantic" stringValue="PROBLEM_ZERO_RESPONSIBLE_CONFIRM"/>
        <flowable:field name="pageCode" stringValue="ProblemZero/ResponsibleConfirmForm"/>
        <flowable:field name="isConvergencePoint" stringValue="false"/>
      </extensionElements>
      <multiInstanceLoopCharacteristics isSequential="false"
                                        flowable:collection="${responsibleAssigneeList}"
                                        flowable:elementVariable="responsibleAssignee">
        <completionCondition>${nrOfCompletedInstances &gt;= 1}</completionCondition>
      </multiInstanceLoopCharacteristics>
    </userTask>

    <sequenceFlow id="flow_ut04_to_eg02"
                  sourceRef="ut04_responsible_confirm"
                  targetRef="eg02_problem_attribute"/>

    <exclusiveGateway id="eg02_problem_attribute" name="是否专项工作？"/>

    <sequenceFlow id="flow_eg02_true_to_ut05"
                  name="专项工作"
                  sourceRef="eg02_problem_attribute"
                  targetRef="ut05_counterpart_leader_review">
      <conditionExpression xsi:type="tFormalExpression">${PROBLEM_ATTRIBUTE == true}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="flow_eg02_false_to_ut06"
                  name="非专项工作"
                  sourceRef="eg02_problem_attribute"
                  targetRef="ut06_discoverer_confirm">
      <conditionExpression xsi:type="tFormalExpression">${PROBLEM_ATTRIBUTE == false}</conditionExpression>
    </sequenceFlow>

    <userTask id="ut05_counterpart_leader_review"
              name="对口领导审核"
              flowable:assignee="${counterpartLeaderAssignee.asText()}">
      <documentation>
        处理人: UT-04 完成时通过 counterpartLeaderAssigneeList 指定，节点并行或签
        操作: 专项工作对口领导审核
        slots: 选发现问题人 -> discovererAssigneeList
      </documentation>
      <extensionElements>
        <flowable:field name="nodeSemantic" stringValue="PROBLEM_ZERO_COUNTERPART_LEADER_REVIEW"/>
        <flowable:field name="pageCode" stringValue="ProblemZero/CounterpartLeaderReviewForm"/>
        <flowable:field name="isConvergencePoint" stringValue="false"/>
      </extensionElements>
      <multiInstanceLoopCharacteristics isSequential="false"
                                        flowable:collection="${counterpartLeaderAssigneeList}"
                                        flowable:elementVariable="counterpartLeaderAssignee">
        <completionCondition>${nrOfCompletedInstances &gt;= 1}</completionCondition>
      </multiInstanceLoopCharacteristics>
    </userTask>

    <sequenceFlow id="flow_ut05_to_ut06"
                  sourceRef="ut05_counterpart_leader_review"
                  targetRef="ut06_discoverer_confirm"/>

    <userTask id="ut06_discoverer_confirm"
              name="发现问题人确认"
              flowable:assignee="${discovererAssignee.asText()}">
      <documentation>
        处理人: 非专项路径由 UT-04 选择，专项路径由 UT-05 选择 discovererAssigneeList
        操作: 发现问题人最终确认，问题归零
        slots: 无
        isConvergencePoint: true
      </documentation>
      <extensionElements>
        <flowable:field name="nodeSemantic" stringValue="PROBLEM_ZERO_DISCOVERER_CONFIRM"/>
        <flowable:field name="pageCode" stringValue="ProblemZero/DiscovererConfirmForm"/>
        <flowable:field name="isConvergencePoint" stringValue="true"/>
      </extensionElements>
      <multiInstanceLoopCharacteristics isSequential="false"
                                        flowable:collection="${discovererAssigneeList}"
                                        flowable:elementVariable="discovererAssignee">
        <completionCondition>${nrOfCompletedInstances &gt;= 1}</completionCondition>
      </multiInstanceLoopCharacteristics>
    </userTask>

    <sequenceFlow id="flow_ut06_to_st07"
                  sourceRef="ut06_discoverer_confirm"
                  targetRef="st07_framework_callback"/>

    <serviceTask id="st07_framework_callback"
                 name="框架回调业务系统"
                 flowable:type="http">
      <documentation>
        框架标准回调节点，引擎 POST frameworkCallbackUrl。
        流程中心接收后更新流程状态，并按启动 callback.url 通知业务系统。
      </documentation>
      <extensionElements>
        <flowable:field name="requestMethod">
          <flowable:string>POST</flowable:string>
        </flowable:field>
        <flowable:field name="requestUrl">
          <flowable:expression>${frameworkCallbackUrl}</flowable:expression>
        </flowable:field>
        <flowable:field name="requestHeaders">
          <flowable:string>Content-Type: application/json</flowable:string>
        </flowable:field>
        <flowable:field name="requestBody">
          <flowable:expression>{"processInstanceId":"${execution.processInstanceId}","businessId":"${businessId}","processDefinitionKey":"${processDefinitionKey}"}</flowable:expression>
        </flowable:field>
        <flowable:field name="saveResponseParameters">
          <flowable:string>false</flowable:string>
        </flowable:field>
      </extensionElements>
    </serviceTask>

    <sequenceFlow id="flow_st07_to_end"
                  sourceRef="st07_framework_callback"
                  targetRef="end_event"/>

    <endEvent id="end_event" name="结束"/>

  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_problem_zero">
    <bpmndi:BPMNPlane id="BPMNPlane_problem_zero"
                      bpmnElement="problem_zero">

      <bpmndi:BPMNShape id="shape_start_event" bpmnElement="start_event">
        <omgdc:Bounds x="82" y="142" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_ut01" bpmnElement="ut01_starter_submit">
        <omgdc:Bounds x="160" y="120" width="180" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_ut02" bpmnElement="ut02_team_leader_confirm">
        <omgdc:Bounds x="390" y="120" width="200" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_ut03" bpmnElement="ut03_quality_group_confirm">
        <omgdc:Bounds x="640" y="120" width="190" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_eg01" bpmnElement="eg01_is_solved" isMarkerVisible="true">
        <omgdc:Bounds x="885" y="135" width="50" height="50"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_ut04" bpmnElement="ut04_responsible_confirm">
        <omgdc:Bounds x="990" y="120" width="180" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_eg02" bpmnElement="eg02_problem_attribute" isMarkerVisible="true">
        <omgdc:Bounds x="1225" y="135" width="50" height="50"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_ut05" bpmnElement="ut05_counterpart_leader_review">
        <omgdc:Bounds x="1330" y="40" width="180" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_ut06" bpmnElement="ut06_discoverer_confirm">
        <omgdc:Bounds x="1330" y="200" width="200" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_st07" bpmnElement="st07_framework_callback">
        <omgdc:Bounds x="1600" y="200" width="180" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_end_event" bpmnElement="end_event">
        <omgdc:Bounds x="1840" y="222" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="edge_start_to_ut01" bpmnElement="flow_start_to_ut01">
        <omgdi:waypoint x="118" y="160"/>
        <omgdi:waypoint x="160" y="160"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_ut01_to_ut02" bpmnElement="flow_ut01_to_ut02">
        <omgdi:waypoint x="340" y="160"/>
        <omgdi:waypoint x="390" y="160"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_ut02_to_ut03" bpmnElement="flow_ut02_to_ut03">
        <omgdi:waypoint x="590" y="160"/>
        <omgdi:waypoint x="640" y="160"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_ut03_to_eg01" bpmnElement="flow_ut03_to_eg01">
        <omgdi:waypoint x="830" y="160"/>
        <omgdi:waypoint x="885" y="160"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_eg01_false_to_ut04" bpmnElement="flow_eg01_false_to_ut04">
        <omgdi:waypoint x="935" y="160"/>
        <omgdi:waypoint x="990" y="160"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_ut04_to_eg02" bpmnElement="flow_ut04_to_eg02">
        <omgdi:waypoint x="1170" y="160"/>
        <omgdi:waypoint x="1225" y="160"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_eg02_true_to_ut05" bpmnElement="flow_eg02_true_to_ut05">
        <omgdi:waypoint x="1250" y="135"/>
        <omgdi:waypoint x="1250" y="80"/>
        <omgdi:waypoint x="1330" y="80"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_ut05_to_ut06" bpmnElement="flow_ut05_to_ut06">
        <omgdi:waypoint x="1420" y="120"/>
        <omgdi:waypoint x="1420" y="200"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_eg02_false_to_ut06" bpmnElement="flow_eg02_false_to_ut06">
        <omgdi:waypoint x="1250" y="185"/>
        <omgdi:waypoint x="1250" y="240"/>
        <omgdi:waypoint x="1330" y="240"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_ut06_to_st07" bpmnElement="flow_ut06_to_st07">
        <omgdi:waypoint x="1530" y="240"/>
        <omgdi:waypoint x="1600" y="240"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_eg01_true_to_st07" bpmnElement="flow_eg01_true_to_st07">
        <omgdi:waypoint x="910" y="185"/>
        <omgdi:waypoint x="910" y="320"/>
        <omgdi:waypoint x="1690" y="320"/>
        <omgdi:waypoint x="1690" y="280"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_st07_to_end" bpmnElement="flow_st07_to_end">
        <omgdi:waypoint x="1780" y="240"/>
        <omgdi:waypoint x="1840" y="240"/>
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
